{
  "functions": {
    "api/translate.ts": {
      "maxDuration": 60
    },
    "api/relayer.ts": {
      "maxDuration": 60
    },
    "api/cron/settle-sweep.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/settle-sweep",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin-support-question-analytics",
      "destination": "/api/admin-telegram-message?mode=support-analytics"
    },
    {
      "source": "/api/telegram-ops-callback",
      "destination": "/api/telegram-callback?mode=ops"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
