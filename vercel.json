{
  "functions": {
    "api/translate.ts": {
      "maxDuration": 60
    },
    "api/relayer.ts": {
      "maxDuration": 60
    },
    "api/cron/settle-sweep.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/settle-sweep",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
